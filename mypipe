- name: dockerComposePath
  value: /tmp/mycontaiber
stages:
- stage: Build
  displayName: Build image
  jobs:
  - job: Build
    displayName: Build
    pool:
      vmImage: ubuntu-latest
    steps:
    #- task: Bash@3
    #  inputs:
    #    targetType: inline
    #    script: |
    #      sudo mkdir $(dockerComposePath)
    #      sudo curl -SL https://github.com/docker/compose/releases/download/v2.40.3/docker-compose-linux-x86_64 -o $(dockerComposePath)/docker-compose
    #      sudo chmod 755 $(dockerComposePath)/docker-compose
    - task: Docker@2
      inputs:
        containerRegistry: 'Docker Hub Service'
        command: 'login'  
    #- task: DockerCompose@1
    #  inputs:
    #    containerregistrytype: 'Container Registry'
    #    dockerRegistryEndpoint: 'Docker Hub Service'
    #    action: 'Run a Docker Compose command'
    #    dockerComposeFile: '**/docker/my-docker-compose-build.yaml'
    #    dockerComposeCommand: 'build amd64-ffmpeg'
      #    dockerComposePath: $(dockerComposePath)
    - task: DockerCompose@1
      inputs:
        containerregistrytype: 'Container Registry'
        dockerRegistryEndpoint: 'Docker Hub Service'
        dockerComposeFile: '**/docker/my-docker-compose-build.yaml'
        dockerComposeFileArgs: |
          UBUNTU_VERSION="noble"
          UBUNTU_VERSION_NUMBER="24.04"
          NODE_VERSION="22.20.0"
          BASE_VERSION="1.9.0"
          OPENCV_VERSION="4.10.0"
          OPENVINO_VERSION="2024.0.0"
        projectName: '$(Build.BuildId)'
        action: 'Run a Docker Compose command'
        dockerComposeCommand: 'build'
        arguments: 'amd64-ffmpeg'
        nopIfNoDockerComposeFile: true
        requireAdditionalDockerComposeFiles: true
        #dockerComposePath: '/docker-compose'
    - task: Docker@2
      inputs:
        containerRegistry: 'Docker Hub Service'
        repository: 'brecky'
        command: 'push'
    - task: Docker@2
      inputs:
        containerRegistry: 'Docker Hub Service'
        command: 'logout'
      