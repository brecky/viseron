trigger:
  branches:
    include:
    - myproject
resources:
  repositories:
  - repository: self
variables:
- name: tag
  value: '$(Build.BuildId)'
- name: dockerComposePath
  value: /tmp/mycontaiber
  # Set your Docker Hub username securely in the pipeline variables UI
- name: dockerUsername
  value: 'brecky' 
- name: imageName 
  value: '$(dockerUsername)/my-application'
- name: buildTag
  value: '$(Build.BuildId)'
- name: latestTag
  value: 'latest'
- name: imageRepository 
  value: 'brecky/amd64-ffmpeg' 
- name: dockerfilePath
  value: '$(Build.SourcesDirectory)/Dockerfile'
 
stages:
- stage: Build
  displayName: Build image
  jobs:
  - job: Build
    displayName: Build
    pool:
      vmImage: ubuntu-latest
    steps:
    - task: DockerCompose@1
      displayName: Build in Compose
      inputs:
        dockerComposeFile: '**/docker/my-docker-compose-build.yaml'
        projectName: '$(Build.BuildId)'
        action: 'Run a Docker Compose command'
        dockerComposeCommand: 'build'
        arguments: 'amd64-ffmpeg'
        nopIfNoDockerComposeFile: true
        requireAdditionalDockerComposeFiles: true
    - task: Docker@2
      displayName: Login and push to Docker Hub
      inputs:
        containerRegistry: 'Docker Hub Service'
        repository: '$(Build.BuildId)'
        command: 'push'
        tags: |
          $(buildTag)
    
    - task: Docker@2
      displayName: Logout from Docker Hub
      inputs:
        containerRegistry: 'Docker Hub Service'
        command: 'logout'
      
